---
import BaseHead from '../components/BaseHead.astro';
import CategoryCards from '../components/CategoryCards.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const latestPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
			}
			.hero {
				margin: 0 0 3rem 0;
			}
			.hero h1 {
				margin: 0 0 1rem 0;
				font-size: 2.6rem;
				line-height: 1.15;
			}
			.hero .subhead {
				margin: 0 0 1.5rem 0;
				font-size: 1.15rem;
				line-height: 1.6;
				color: rgb(var(--muted-rgb));
				max-width: 640px;
			}
			.intro-list {
				margin: 0;
				padding: 0 0 0 1.25rem;
				font-size: 0.95rem;
				line-height: 1.7;
			}
			.intro-list li {
				margin-bottom: 0.4rem;
			}
			section {
				margin: 0 0 3.5rem 0;
			}
			.section-title {
				margin: 0 0 1.5rem 0;
				font-size: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Answers to the questions traders actually ask.</h1>
<p class="subhead">
	Most trading content starts with what the writer wants to say. This starts with what
	people are already typing into search bars and DMs. 
	<br>We research it against our own
	trade records and publish the full answer here first. Everything shorter, the posts,
	the threads, the replies, is cut from this.
</p>
				<ul class="intro-list">
					<li>Full answers to the questions people are already asking about signals, risk, verification, and losses</li>
					<li>The evidence and the reasoning in the same place</li>
					<li>Losses treated the same way as wins; same tense, same detail</li>
				</ul>
			</section>

			<section>
				<h2 class="section-title">Browse by category</h2>
				<CategoryCards />
			</section>

			{featuredPosts.length > 0 && (
				<section>
					<h2 class="section-title">Popular questions</h2>
					<PostList posts={featuredPosts} />
				</section>
			)}

			<section>
				<h2 class="section-title">Latest articles</h2>
				<PostList posts={latestPosts} />
			</section>
		</main>
		<Footer />
	</body>
</html>