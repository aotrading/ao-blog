---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getPublishedPosts, postUrl } from '../lib/posts';

// Pagefind is generated after the static build. Keep the title index available
// to the dev server and as a fallback if the built index cannot be loaded.
const searchPosts = (await getPublishedPosts()).map((post) => ({
	url: postUrl(post.id),
	meta: { title: post.data.title },
}));
const searchPostsJson = JSON.stringify(searchPosts).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Search | ${SITE_TITLE}`}
			description="Search all articles on the AO Trading blog."
		/>
		<meta name="robots" content="noindex" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em 3em;
			}
			.page-title {
				margin: 0 0 0.5rem 0;
				font-size: 2.2rem;
			}
			.rule {
				width: 56px;
				height: 3px;
				margin: 0 0 2rem 0;
				background: var(--brand-yellow);
			}
			.search-box {
				position: relative;
			}
			.search-box input {
				width: 100%;
				padding: 0.75em 1em;
				font: inherit;
				color: var(--text);
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 8px;
			}
			.search-box input:focus-visible {
				outline: 2px solid var(--brand-yellow);
				outline-offset: 2px;
			}
			.status {
				margin: 1em 0 0;
				font-size: 0.9rem;
				color: rgb(var(--muted-rgb));
			}
		</style>
		<!-- Result rows are created by script at runtime, so they carry no Astro
		     scope attribute — these rules must be global to apply to them. -->
		<style is:global>
			.results {
				margin: 1.5em 0 0;
				padding: 0;
				list-style: none;
			}
			.results li + li {
				margin-top: 1em;
			}
			.results a {
				display: block;
				padding: 1em 1.25em;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--surface);
				color: var(--text);
				text-decoration: none;
				transition: border-color 0.2s ease;
			}
			.results a:hover,
			.results a:focus-visible {
				border-color: var(--brand-yellow);
			}
			.results .result-title {
				display: block;
				font-weight: 700;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<h1 class="page-title">Search</h1>
			<div class="rule"></div>

			<div class="search-box">
				<label class="visually-hidden" for="search-input">Search articles</label>
				<input
					id="search-input"
					type="search"
					placeholder="Search articles…"
					autocomplete="off"
					autofocus
				/>
			</div>
			<p class="status" id="search-status" aria-live="polite">Type to search all articles.</p>
			<ul class="results" id="search-results"></ul>
			<script id="search-posts" type="application/json" data-pagefind={import.meta.env.PROD} set:html={searchPostsJson}></script>
		</main>
		<Footer />
	</body>
</html>

<!-- is:inline: Pagefind is generated after the static build, so the dynamic
     import must ship unprocessed. Development uses the embedded title index. -->
<script is:inline>
	(function () {
		var input = document.getElementById('search-input');
		var resultsList = document.getElementById('search-results');
		var status = document.getElementById('search-status');
		var searchData = document.getElementById('search-posts');
		var fallbackPosts = JSON.parse(searchData.textContent);
		var usePagefind = searchData.dataset.pagefind === 'true';

		// The Pagefind index is generated after the static build. Development
		// searches the embedded titles directly; production can fall back to them.
		var pagefindPromise;
		function loadPagefind() {
			if (!pagefindPromise) pagefindPromise = import('/pagefind/pagefind.js');
			return pagefindPromise;
		}
		var debounce;
		var requestId = 0;

		function fallbackSearch(query) {
			var words = query.toLocaleLowerCase().split(/\s+/);
			return fallbackPosts.filter(function (post) {
				var title = post.meta.title.toLocaleLowerCase();
				return words.every(function (word) { return title.includes(word); });
			});
		}

		function showResults(data, query) {
			var seen = new Set();
			var articles = data.filter(function (article) {
				var url = new URL(article.url, window.location.origin);
				url.hash = '';
				url.pathname = url.pathname.replace(/\/index\.html$/, '/').replace(/\/$/, '');
				if (seen.has(url.href)) return false;
				seen.add(url.href);
				return true;
			});
			var rows = articles.slice(0, 8).map(function (article) {
				var li = document.createElement('li');
				var link = document.createElement('a');
				link.href = article.url;
				var title = document.createElement('span');
				title.className = 'result-title';
				title.textContent = article.meta.title;
				link.append(title);
				li.append(link);
				return li;
			});
			resultsList.replaceChildren(...rows);
			status.textContent = articles.length === 0
				? 'No articles found for \u201C' + query + '\u201D.'
				: articles.length + ' ' + (articles.length === 1 ? 'article' : 'articles') +
					' found for \u201C' + query + '\u201D.' + (articles.length > 8 ? ' Showing the first 8.' : '');
		}

		async function runSearch(query, id) {
			if (!usePagefind) {
				showResults(fallbackSearch(query), query);
				return;
			}
			try {
				var pagefind = await loadPagefind();
				if (id !== requestId) return;
				var search = await pagefind.search(query);
				if (id !== requestId) return;
				// Resolve together to retain relevance order and render only once.
				var data = await Promise.all(search.results.map(function (result) {
					return result.data();
				}));
				if (id !== requestId) return;

				showResults(data, query);
			} catch (error) {
				if (id !== requestId) return;
				pagefindPromise = null;
				usePagefind = false;
				showResults(fallbackSearch(query), query);
			}
		}

		input.addEventListener('input', function () {
			clearTimeout(debounce);
			// Invalidate immediately, including during the debounce or a clear.
			var id = ++requestId;
			var query = input.value.trim();
			resultsList.replaceChildren();
			status.textContent = query ? 'Searching…' : 'Type to search all articles.';
			if (query) debounce = setTimeout(function () { runSearch(query, id); }, 180);
		});
	})();
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
</style>
