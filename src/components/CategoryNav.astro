---
import { categories } from '../lib/categories';

interface Props {
	active?: string; // a category slug; omit for "All"
}

const { active } = Astro.props;

const links = [
	{ label: 'All', href: '/blog/', slug: undefined },
	...categories.map((c) => ({ label: c.name, href: `/blog/category/${c.slug}/`, slug: c.slug })),
];
---

<nav class="category-nav" aria-label="Filter articles by category">
	{
		links.map((link) => (
			<a href={link.href} aria-current={link.slug === active ? 'page' : undefined}>
				{link.label}
			</a>
		))
	}
</nav>

<style>
	.category-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2rem 0;
	}
	a {
		padding: 0.4rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.85rem;
		color: var(--text);
		text-decoration: none;
	}
	a:hover {
		border-color: var(--brand-yellow);
	}
	a[aria-current='page'] {
		background: var(--brand-yellow);
		border-color: var(--brand-yellow);
		color: #111111;
		font-weight: 700;
	}
</style>