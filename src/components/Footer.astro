---
import RiskDisclaimer from './RiskDisclaimer.astro';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} AO Trading. All rights reserved.</p>
	<RiskDisclaimer compact />
	<p><a href="https://aotrading.io">Visit the main website</a></p>
</footer>

<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: var(--surface);
		border-top: 1px solid var(--line);
		color: rgb(var(--muted-rgb));
		text-align: center;
		font-size: 0.85em;
	}
	footer p {
		margin: 0 0 0.5em 0;
	}
	footer a {
		color: var(--text);
	}
</style>